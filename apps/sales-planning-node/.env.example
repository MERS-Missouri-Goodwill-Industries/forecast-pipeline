# Copy this file to .env (already gitignored) and fill in real values for local development.
# In production (deployed as a Databricks App), DATABRICKS_HOST / DATABRICKS_CLIENT_ID /
# DATABRICKS_CLIENT_SECRET are auto-injected once a SQL warehouse resource is bound to the app —
# do not set them here for production.

DATABRICKS_HOST=adb-201205741376717.17.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/3d33bbee9a23df31

# Local-dev-only auth: a personal access token (Databricks workspace -> User Settings ->
# Developer -> Access Tokens). Never commit a real token.
DATABRICKS_TOKEN=
